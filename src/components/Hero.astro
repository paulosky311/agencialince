---
import data from '../data/hero.json';
---

<section id="hero" style="position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;">
  <canvas id="particle-canvas" style="position:absolute;inset:0;width:100%;height:100%;"></canvas>

  <div class="section-inner" style="position:relative;z-index:2;padding-top:120px;padding-bottom:80px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
    <div>
      <span style="display:inline-block;font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);border:1px solid rgba(29,230,181,0.3);padding:5px 14px;border-radius:20px;margin-bottom:28px;">
        {data.label}
      </span>
      <h1 style="font-family:var(--serif);font-size:clamp(42px,5vw,68px);line-height:1.1;letter-spacing:-1px;margin-bottom:24px;">
        {data.h1_pre} <em style="color:var(--accent);font-style:italic;">{data.h1_em}</em>
      </h1>
      <p style="font-size:17px;color:var(--muted);line-height:1.75;margin-bottom:40px;max-width:480px;">
        {data.subtitulo}
      </p>
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <a href="#contacto" class="btn-primary">{data.cta_primary}</a>
        <a href="#casos"    class="btn-ghost">{data.cta_secondary} →</a>
      </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px;">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        {data.stats.map(s => (
          <div style="background:rgba(30,34,48,0.85);border:1px solid var(--border);border-radius:var(--radius);padding:24px 22px;backdrop-filter:blur(8px);">
            <div style="font-family:var(--serif);font-size:38px;color:var(--accent);line-height:1;">{s.num}</div>
            <div style="font-size:13px;color:var(--muted);margin-top:6px;">{s.label}</div>
          </div>
        ))}
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        {data.tags.map(t => (
          <span style="font-size:12px;padding:6px 14px;border-radius:20px;border:1px solid var(--border);color:var(--muted);background:var(--bg3);">{t}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- LOGOS BAR -->
<div id="logos" style="padding:52px 48px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg2);">
  <div class="section-inner" style="padding:0;">
    <p style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:32px;">{data.logos_label}</p>
    <div style="display:flex;gap:48px;align-items:center;justify-content:center;flex-wrap:wrap;">
      {[1,2,3,4,5,6].map(() => (
        <div style="width:110px;height:32px;background:var(--faint);border-radius:4px;opacity:0.5;"></div>
      ))}
    </div>
  </div>
</div>

<script>
(function() {
  const canvas = document.getElementById('particle-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, particles = [];
  const mouse = { x: -9999, y: -9999 };
  const COUNT = 90, MAX_DIST = 160, MOUSE_DIST = 200;

  function resize() {
    W = canvas.width  = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }

  function Particle() {
    this.x     = Math.random() * W;
    this.y     = Math.random() * H;
    this.vx    = (Math.random() - 0.5) * 0.45;
    this.vy    = (Math.random() - 0.5) * 0.45;
    this.r     = Math.random() * 1.8 + 0.6;
    this.depth = Math.random();
  }

  Particle.prototype.update = function(scrollY) {
    this.x += this.vx;
    this.y += this.vy;
    if (this.x < 0 || this.x > W) this.vx *= -1;
    if (this.y < 0 || this.y > H) this.vy *= -1;
    this._dy = this.y - scrollY * this.depth * 0.08;
  };

  function init() { resize(); particles = Array.from({ length: COUNT }, () => new Particle()); }

  let scrollY = 0;
  window.addEventListener('scroll', () => { scrollY = window.scrollY; });
  window.addEventListener('resize', resize);
  canvas.addEventListener('mousemove', e => {
    const r = canvas.getBoundingClientRect();
    mouse.x = e.clientX - r.left;
    mouse.y = e.clientY - r.top;
  });
  canvas.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });

  function draw() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => p.update(scrollY));

    for (let i = 0; i < particles.length; i++) {
      const a = particles[i], ay = a._dy ?? a.y;
      for (let j = i + 1; j < particles.length; j++) {
        const b = particles[j], by = b._dy ?? b.y;
        const d = Math.hypot(a.x - b.x, ay - by);
        if (d < MAX_DIST) {
          ctx.beginPath();
          ctx.moveTo(a.x, ay); ctx.lineTo(b.x, by);
          ctx.strokeStyle = `rgba(29,230,181,${(1 - d / MAX_DIST) * 0.25})`;
          ctx.lineWidth = 0.6; ctx.stroke();
        }
      }
      const md = Math.hypot(a.x - mouse.x, ay - mouse.y);
      if (md < MOUSE_DIST) {
        ctx.beginPath();
        ctx.moveTo(a.x, ay); ctx.lineTo(mouse.x, mouse.y);
        ctx.strokeStyle = `rgba(29,230,181,${(1 - md / MOUSE_DIST) * 0.55})`;
        ctx.lineWidth = 0.8; ctx.stroke();
      }
    }

    particles.forEach(p => {
      const py = p._dy ?? p.y;
      const md = Math.hypot(p.x - mouse.x, py - mouse.y);
      const glow = md < MOUSE_DIST ? (1 - md / MOUSE_DIST) : 0;
      ctx.beginPath();
      ctx.arc(p.x, py, p.r + glow * 1.2, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(29,230,181,${0.35 + p.depth * 0.35 + glow * 0.3})`;
      ctx.fill();
    });

    requestAnimationFrame(draw);
  }

  init(); draw();
})();
</script>
