---
const servicios = await Astro.glob('../content/servicios/*.md');
const sorted = servicios.sort((a,b) => a.frontmatter.orden - b.frontmatter.orden);
---

<section id="servicios" style="background:var(--bg);padding:100px 48px;">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-eyebrow">Servicios</p>
      <h2 class="section-h2">Tres maneras de hacer<br>crecer tu negocio</h2>
      <p class="section-sub">[SUBTÍTULO — Texto por redactar. Un párrafo que conecte los tres servicios entre sí. Aprox. 25–30 palabras.]</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {sorted.map((s, i) => (
        <div class="reveal service-card" style={`transition-delay:${i * 0.1}s`}>
          <div class={`service-icon ${s.frontmatter.tipo}`}>{s.frontmatter.icono}</div>
          <h3 class="service-name">{s.frontmatter.nombre}</h3>
          <p class="service-desc">{s.frontmatter.descripcion_corta}</p>
          <ul class="service-bullets">
            {s.frontmatter.entregables.map((e: string) => <li>{e}</li>)}
          </ul>
          <a href={`/servicios/${s.frontmatter.slug}`} class="service-link">{s.frontmatter.cta} →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.service-card {
  background: var(--card); border: 1px solid var(--border); border-radius: 16px;
  padding: 36px 32px; position: relative; overflow: hidden;
  transition: border-color .3s, transform .3s; cursor: pointer;
}
.service-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:var(--accent); opacity:0; transition:opacity .3s; }
.service-card:hover { border-color: rgba(29,230,181,0.2); transform: translateY(-4px); }
.service-card:hover::before { opacity: 1; }
.service-icon { width:48px;height:48px;border-radius:10px;margin-bottom:24px;display:flex;align-items:center;justify-content:center;font-size:22px; }
.service-icon.crm    { background:rgba(123,110,246,0.15); color:var(--purple); }
.service-icon.ecom   { background:rgba(29,230,181,0.12);  color:var(--accent); }
.service-icon.social { background:rgba(246,165,29,0.12);  color:#f6a51d; }
.service-name  { font-family:var(--serif);font-size:24px;margin-bottom:14px;line-height:1.2; }
.service-desc  { font-size:15px;color:var(--muted);line-height:1.7;margin-bottom:28px; }
.service-bullets { list-style:none;display:flex;flex-direction:column;gap:10px;margin-bottom:32px; }
.service-bullets li { font-size:14px;color:var(--muted);display:flex;gap:10px;align-items:flex-start; }
.service-bullets li::before { content:'→';color:var(--accent);flex-shrink:0;margin-top:1px; }
.service-link { font-size:14px;font-weight:500;color:var(--accent);text-decoration:none;display:flex;align-items:center;gap:6px;transition:gap .2s; }
.service-link:hover { gap:10px; }
@media (max-width:900px) { div[style*="repeat(3"] { grid-template-columns:1fr !important; } }
</style>
