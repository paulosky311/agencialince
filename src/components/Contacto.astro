---
import data from '../data/contacto.json';
---

<section id="contacto" style="background:var(--bg);padding:100px 48px;">
  <div class="section-inner">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <div class="reveal">
        <p class="section-eyebrow">{data.eyebrow}</p>
        <h2 class="section-h2">{data.titulo}</h2>
        <p style="font-size:16px;color:var(--muted);margin-bottom:36px;line-height:1.75;">{data.subtitulo}</p>

        <div style="display:flex;flex-direction:column;gap:16px;margin-bottom:40px;">
          <div style="display:flex;gap:14px;align-items:center;">
            <div style="width:40px;height:40px;border-radius:8px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">✉</div>
            <div>
              <strong style="color:var(--text);display:block;font-size:14px;">Email</strong>
              <span style="font-size:15px;color:var(--muted);">{data.email}</span>
            </div>
          </div>
          <div style="display:flex;gap:14px;align-items:center;">
            <div style="width:40px;height:40px;border-radius:8px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">💬</div>
            <div>
              <strong style="color:var(--text);display:block;font-size:14px;">WhatsApp</strong>
              <span style="font-size:15px;color:var(--muted);">{data.whatsapp}</span>
            </div>
          </div>
          <div style="display:flex;gap:14px;align-items:center;">
            <div style="width:40px;height:40px;border-radius:8px;background:var(--bg3);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;">🕐</div>
            <div>
              <strong style="color:var(--text);display:block;font-size:14px;">Tiempo de respuesta</strong>
              <span style="font-size:15px;color:var(--muted);">{data.respuesta}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal" style="background:var(--card);border:1px solid var(--border);border-radius:20px;padding:40px 36px;transition-delay:.15s;">
        <form name="contacto" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contacto" />
          <p style="display:none;"><input name="bot-field" /></p>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
            <div style="display:flex;flex-direction:column;gap:8px;">
              <label style="font-size:13px;color:var(--muted);font-weight:500;">Nombre</label>
              <input name="nombre" type="text" placeholder="Tu nombre" required style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 16px;color:var(--text);font-size:15px;font-family:var(--sans);outline:none;transition:border-color .2s;" />
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;">
              <label style="font-size:13px;color:var(--muted);font-weight:500;">Empresa</label>
              <input name="empresa" type="text" placeholder="Nombre de tu empresa" style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 16px;color:var(--text);font-size:15px;font-family:var(--sans);outline:none;transition:border-color .2s;" />
            </div>
          </div>

          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
            <label style="font-size:13px;color:var(--muted);font-weight:500;">Email</label>
            <input name="email" type="email" placeholder="tu@email.com" required style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 16px;color:var(--text);font-size:15px;font-family:var(--sans);outline:none;" />
          </div>

          <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
            <label style="font-size:13px;color:var(--muted);font-weight:500;">¿En qué necesitas ayuda?</label>
            <textarea name="mensaje" placeholder="Cuéntanos brevemente tu proyecto o desafío..." rows="4" style="background:var(--bg3);border:1px solid var(--border);border-radius:8px;padding:12px 16px;color:var(--text);font-size:15px;font-family:var(--sans);outline:none;resize:vertical;"></textarea>
          </div>

          <button type="submit" style="width:100%;background:var(--accent);color:#0d0f14;border:none;padding:15px;border-radius:8px;font-size:15px;font-weight:500;cursor:pointer;font-family:var(--sans);transition:background .2s;margin-top:8px;">
            Enviar mensaje
          </button>
          <p style="font-size:12px;color:var(--muted);text-align:center;margin-top:12px;">{data.nota_privacidad}</p>
        </form>
      </div>

    </div>
  </div>
</section>
