---
import data from '../data/proceso.json';
---

<section id="proceso" style="background:var(--bg2);padding:100px 48px;">
  <div class="section-inner">
    <div class="reveal" style="text-align:center;max-width:600px;margin:0 auto 72px;">
      <p class="section-eyebrow">{data.eyebrow}</p>
      <h2 class="section-h2">{data.titulo}</h2>
      <p class="section-sub" style="margin:0 auto;">{data.subtitulo}</p>
    </div>

    <div class="steps">
      {data.pasos.map((p, i) => (
        <div class="step reveal" style={`transition-delay:${i * 0.1}s`}>
          <div class="step-dot">{p.num}</div>
          <h4 class="step-title">{p.titulo}</h4>
          <p class="step-desc">{p.descripcion}</p>
          <p class="step-time">{p.tiempo}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.steps {
  display: grid; grid-template-columns: repeat(4,1fr); gap:0; position:relative;
}
.steps::before {
  content:''; position:absolute; top:36px; left:10%; right:10%; height:1px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent); z-index:0;
}
.step { text-align:center; padding:0 20px; position:relative; z-index:1; }
.step-dot {
  width:72px; height:72px; border-radius:50%; margin:0 auto 28px;
  display:flex; align-items:center; justify-content:center;
  font-family:var(--serif); font-size:24px; color:var(--accent);
  background:var(--bg3); border:1px solid rgba(29,230,181,0.25);
}
.step-title { font-family:var(--serif); font-size:20px; margin-bottom:12px; }
.step-desc  { font-size:14px; color:var(--muted); line-height:1.65; }
.step-time  { font-size:12px; color:var(--accent); margin-top:12px; font-weight:500; }
@media (max-width:900px) {
  .steps { grid-template-columns:1fr 1fr; }
  .steps::before { display:none; }
}
</style>
