---
import data from '../data/nosotros.json';
---

<section id="nosotros" style="background:var(--bg);padding:100px 48px;">
  <div class="section-inner">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <div class="reveal">
        <p class="section-eyebrow">{data.eyebrow}</p>
        <h2 class="section-h2">{data.titulo}</h2>
        <p style="font-size:16px;color:var(--muted);line-height:1.8;margin-bottom:28px;">{data.historia}</p>

        <div style="display:flex;flex-direction:column;gap:16px;margin-bottom:40px;">
          {data.valores.map(v => (
            <div style="display:flex;gap:14px;align-items:flex-start;">
              <div style="width:8px;height:8px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:8px;"></div>
              <p style="font-size:15px;color:var(--muted);">{v}</p>
            </div>
          ))}
        </div>

        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px;">
          {data.nums.map(n => (
            <div style="text-align:center;">
              <div style="font-family:var(--serif);font-size:40px;color:var(--accent);">{n.num}</div>
              <div style="font-size:13px;color:var(--muted);margin-top:4px;">{n.label}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="reveal" style="transition-delay:.15s;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          {data.equipo.map(m => (
            <div style="background:var(--card);border:1px solid var(--border);border-radius:12px;padding:24px 20px;display:flex;gap:16px;align-items:flex-start;">
              <div style="width:56px;height:56px;border-radius:50%;background:var(--faint);flex-shrink:0;"></div>
              <div>
                <p style="font-size:15px;font-weight:500;margin-bottom:4px;">{m.nombre}</p>
                <p style="font-size:13px;color:var(--accent);margin-bottom:6px;">{m.cargo}</p>
                <p style="font-size:13px;color:var(--muted);line-height:1.6;">{m.bio}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
