---
import data from '../data/testimonios.json';
---

<section id="testimonios" style="background:var(--bg2);padding:100px 48px;">
  <div class="section-inner">
    <div class="reveal" style="text-align:center;max-width:560px;margin:0 auto 60px;">
      <p class="section-eyebrow">{data.eyebrow}</p>
      <h2 class="section-h2">{data.titulo}</h2>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {data.items.map((t, i) => (
        <div class="testi-card reveal" style={`transition-delay:${i * 0.1}s`}>
          <p class="testi-quote">{t.texto}</p>
          <div class="testi-person">
            <div class="testi-avatar"></div>
            <div>
              <p class="testi-name">{t.nombre}</p>
              <p class="testi-role">{t.cargo}, {t.empresa}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.testi-card {
  background:var(--card); border:1px solid var(--border);
  border-radius:16px; padding:32px 28px;
}
.testi-quote { font-size:15px; color:var(--text); line-height:1.75; margin-bottom:24px; font-style:italic; }
.testi-quote::before {
  content:'"'; font-family:var(--serif); font-size:48px; color:var(--accent);
  line-height:0.5; display:block; margin-bottom:16px;
}
.testi-person { display:flex; align-items:center; gap:14px; }
.testi-avatar { width:44px; height:44px; border-radius:50%; background:var(--faint); flex-shrink:0; }
.testi-name   { font-size:14px; font-weight:500; }
.testi-role   { font-size:13px; color:var(--muted); }
@media (max-width:900px) { div[style*="repeat(3"] { grid-template-columns:1fr !important; } }
</style>
