---
const casos = await Astro.glob('../content/casos/*.md');
---

<section id="casos" style="background:var(--bg);padding:100px 48px;">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-eyebrow">Casos de éxito</p>
      <h2 class="section-h2">Resultados que hablan<br>por sí solos</h2>
      <p class="section-sub">[SUBTÍTULO — Texto por redactar. Intro breve a los proyectos. Aprox. 20 palabras.]</p>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:28px;">
      {casos.map((c, i) => (
        <div class="case-card reveal" style={`transition-delay:${i * 0.15}s`}>
          <div class="case-img">
            {c.frontmatter.imagen
              ? <img src={c.frontmatter.imagen} alt={c.frontmatter.cliente} style="width:100%;height:100%;object-fit:cover;" />
              : <span style="position:relative;z-index:1;font-size:13px;color:var(--muted);">[ Imagen del proyecto ]</span>
            }
          </div>
          <div class="case-body">
            <p class="case-industry">{c.frontmatter.industria}</p>
            <h3 class="case-title">{c.frontmatter.cliente}</h3>
            <p class="case-text">{c.frontmatter.solucion}</p>
            <div class="case-metrics">
              {c.frontmatter.metricas.map((m: {valor:string;label:string}) => (
                <div class="metric">
                  <div class="metric-val">{m.valor}</div>
                  <div class="metric-lbl">{m.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.case-card {
  background:var(--card); border:1px solid var(--border); border-radius:16px; overflow:hidden;
  transition: border-color .3s;
}
.case-card:hover { border-color: rgba(29,230,181,0.2); }
.case-img {
  height:200px;
  background: linear-gradient(135deg, var(--bg3), var(--faint));
  display:flex; align-items:center; justify-content:center;
  border-bottom:1px solid var(--border); position:relative; overflow:hidden;
}
.case-body     { padding:32px 28px; }
.case-industry { font-size:11px; text-transform:uppercase; letter-spacing:0.1em; color:var(--accent); margin-bottom:12px; font-weight:500; }
.case-title    { font-family:var(--serif); font-size:22px; margin-bottom:14px; line-height:1.3; }
.case-text     { font-size:14px; color:var(--muted); margin-bottom:24px; line-height:1.65; }
.case-metrics  { display:flex; gap:24px; }
.metric-val    { font-family:var(--serif); font-size:28px; color:var(--accent); line-height:1; }
.metric-lbl    { font-size:12px; color:var(--muted); margin-top:4px; }
@media (max-width:900px) { div[style*="1fr 1fr"] { grid-template-columns:1fr !important; } }
</style>
