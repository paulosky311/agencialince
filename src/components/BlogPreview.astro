---
const posts = await Astro.glob('../content/blog/*.md');
const sorted = posts.sort((a, b) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
).slice(0, 3);
---

<section id="blog" style="background:var(--bg2);padding:100px 48px;">
  <div class="section-inner">
    <div class="reveal" style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;flex-wrap:wrap;gap:24px;">
      <div>
        <p class="section-eyebrow">Recursos</p>
        <h2 class="section-h2" style="margin-bottom:0;">Guías para hacer<br>crecer tu negocio</h2>
      </div>
      <a href="/blog" class="btn-ghost" style="flex-shrink:0;">Ver todos los artículos →</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;">
      {sorted.map((p, i) => (
        <a href={`/blog/${p.frontmatter.slug}`} class="blog-card reveal" style={`transition-delay:${i * 0.1}s`}>
          <div class="blog-img">
            {p.frontmatter.imagen
              ? <img src={p.frontmatter.imagen} alt={p.frontmatter.title} style="width:100%;height:100%;object-fit:cover;" />
              : <span></span>
            }
            <span class="blog-cat">{p.frontmatter.category}</span>
          </div>
          <div class="blog-body">
            <p class="blog-date">{p.frontmatter.date} · {p.frontmatter.minutos} min de lectura</p>
            <h3 class="blog-title">{p.frontmatter.title}</h3>
            <p class="blog-excerpt">{p.frontmatter.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.blog-card {
  background:var(--card); border:1px solid var(--border); border-radius:16px;
  overflow:hidden; text-decoration:none; display:block;
  transition: border-color .3s, transform .3s;
}
.blog-card:hover { border-color:rgba(29,230,181,0.2); transform:translateY(-3px); }
.blog-img {
  height:160px; background:linear-gradient(135deg, var(--bg3), var(--faint));
  border-bottom:1px solid var(--border); position:relative; overflow:hidden;
}
.blog-cat {
  position:absolute; top:14px; left:14px; font-size:11px; font-weight:500;
  padding:4px 12px; border-radius:20px; background:var(--bg); color:var(--accent);
  border:1px solid rgba(29,230,181,0.3);
}
.blog-body    { padding:24px 22px; }
.blog-date    { font-size:12px; color:var(--muted); margin-bottom:10px; }
.blog-title   { font-family:var(--serif); font-size:18px; line-height:1.35; margin-bottom:12px; color:var(--text); }
.blog-excerpt { font-size:14px; color:var(--muted); line-height:1.65; }
@media (max-width:900px) { div[style*="repeat(3"] { grid-template-columns:1fr !important; } }
</style>
