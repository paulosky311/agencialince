---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const servicios = await Astro.glob('../../content/servicios/*.md');
  return servicios.map(s => ({
    params: { slug: s.frontmatter.slug },
    props:  { servicio: s },
  }));
}

const { servicio } = Astro.props;
const { frontmatter, compiledContent } = servicio;
---

<Layout title={`${frontmatter.nombre} — Nexus Digital`}>
  <div style="padding-top:68px;">

    <!-- Hero de servicio -->
    <div style="background:var(--bg2);padding:80px 48px 60px;border-bottom:1px solid var(--border);">
      <div style="max-width:var(--max);margin:0 auto;">
        <a href="/#servicios" style="font-size:13px;color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:32px;">← Volver a servicios</a>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
          <div>
            <span style="display:inline-block;font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);border:1px solid rgba(29,230,181,0.3);padding:5px 14px;border-radius:20px;margin-bottom:24px;">Servicio</span>
            <h1 style="font-family:var(--serif);font-size:clamp(36px,4vw,56px);line-height:1.1;margin-bottom:20px;">{frontmatter.nombre}</h1>
            <p style="font-size:17px;color:var(--muted);line-height:1.75;margin-bottom:36px;">{frontmatter.descripcion_corta}</p>
            <a href="/#contacto" class="btn-primary">Cotizar este servicio</a>
          </div>
          <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px;">
            <h3 style="font-size:14px;font-weight:500;letter-spacing:0.06em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;">Qué incluye</h3>
            <ul style="list-style:none;display:flex;flex-direction:column;gap:14px;">
              {frontmatter.entregables.map((e: string) => (
                <li style="display:flex;gap:12px;align-items:flex-start;font-size:15px;color:var(--text);">
                  <span style="color:var(--accent);flex-shrink:0;margin-top:2px;">→</span>
                  {e}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido largo del MD -->
    <div style="padding:80px 48px;max-width:760px;margin:0 auto;" class="prose">
      <Fragment set:html={compiledContent()} />
    </div>

    <!-- CTA final -->
    <div style="background:var(--bg2);border-top:1px solid var(--border);padding:60px 48px;text-align:center;">
      <h2 style="font-family:var(--serif);font-size:36px;margin-bottom:16px;">¿Te interesa este servicio?</h2>
      <p style="color:var(--muted);margin-bottom:32px;font-size:16px;">Conversemos sobre tu proyecto sin compromiso.</p>
      <a href="/#contacto" class="btn-primary">Agendar llamada gratuita</a>
    </div>

  </div>
</Layout>

<style is:global>
.prose h2 { font-family: var(--serif); font-size: 28px; margin: 48px 0 16px; color: var(--text); }
.prose h3 { font-size: 20px; font-weight: 500; margin: 32px 0 12px; color: var(--text); }
.prose p  { color: var(--muted); font-size: 16px; line-height: 1.8; margin-bottom: 20px; }
.prose ul { list-style: disc; padding-left: 24px; color: var(--muted); margin-bottom: 20px; }
.prose li { margin-bottom: 8px; line-height: 1.7; }
</style>
