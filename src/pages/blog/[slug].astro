---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/blog/*.md');
  return posts.map(p => ({
    params: { slug: p.frontmatter.slug },
    props:  { post: p },
  }));
}

const { post } = Astro.props;
const { frontmatter, compiledContent } = post;
---

<Layout title={`${frontmatter.title} — Nexus Digital`} description={frontmatter.excerpt}>
  <div style="padding-top:68px;">

    <!-- Header del artículo -->
    <div style="background:var(--bg2);padding:80px 48px 60px;border-bottom:1px solid var(--border);">
      <div style="max-width:760px;margin:0 auto;">
        <a href="/blog" style="font-size:13px;color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:32px;">← Volver al blog</a>
        <span style="display:inline-block;font-size:11px;font-weight:500;padding:4px 12px;border-radius:20px;background:var(--bg);color:var(--accent);border:1px solid rgba(29,230,181,0.3);margin-bottom:20px;">{frontmatter.category}</span>
        <h1 style="font-family:var(--serif);font-size:clamp(32px,4vw,52px);line-height:1.15;margin-bottom:20px;">{frontmatter.title}</h1>
        <p style="font-size:14px;color:var(--muted);">{frontmatter.date} · {frontmatter.minutos} min de lectura</p>
      </div>
    </div>

    <!-- Contenido -->
    <div style="padding:72px 48px;max-width:760px;margin:0 auto;" class="prose">
      <Fragment set:html={compiledContent()} />
    </div>

    <!-- CTA al final del artículo -->
    <div style="background:var(--bg2);border-top:1px solid var(--border);padding:60px 48px;">
      <div style="max-width:600px;margin:0 auto;text-align:center;">
        <h2 style="font-family:var(--serif);font-size:32px;margin-bottom:16px;">¿Quieres resultados como estos?</h2>
        <p style="color:var(--muted);margin-bottom:32px;">Agenda una llamada y evaluamos cómo podemos ayudarte.</p>
        <a href="/#contacto" class="btn-primary">Hablar con el equipo</a>
      </div>
    </div>

  </div>
</Layout>

<style is:global>
.prose h2 { font-family:var(--serif); font-size:28px; margin:48px 0 16px; color:var(--text); }
.prose h3 { font-size:20px; font-weight:500; margin:32px 0 12px; color:var(--text); }
.prose p  { color:var(--muted); font-size:16px; line-height:1.85; margin-bottom:20px; }
.prose ul { list-style:disc; padding-left:24px; color:var(--muted); margin-bottom:20px; }
.prose li { margin-bottom:8px; line-height:1.7; }
.prose strong { color:var(--text); font-weight:500; }
.prose a  { color:var(--accent); }
</style>
