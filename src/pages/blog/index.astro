---
import Layout from '../../layouts/Layout.astro';

const posts = await Astro.glob('../../content/blog/*.md');
const sorted = posts.sort((a, b) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Layout title="Blog — Nexus Digital">
  <div style="padding-top:68px;">

    <div style="background:var(--bg2);padding:80px 48px 60px;border-bottom:1px solid var(--border);">
      <div style="max-width:var(--max);margin:0 auto;">
        <p style="font-size:12px;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;">Blog</p>
        <h1 style="font-family:var(--serif);font-size:clamp(36px,4vw,56px);line-height:1.1;margin-bottom:16px;">Recursos y guías</h1>
        <p style="font-size:17px;color:var(--muted);max-width:520px;">Todo lo que necesitas saber para hacer crecer tu negocio con marketing digital.</p>
      </div>
    </div>

    <div style="padding:80px 48px;max-width:var(--max);margin:0 auto;">
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;">
        {sorted.map(p => (
          <a href={`/blog/${p.frontmatter.slug}`} style="text-decoration:none;display:block;background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:border-color .3s,transform .3s;" class="blog-li-card">
            <div style="height:160px;background:linear-gradient(135deg,var(--bg3),var(--faint));position:relative;overflow:hidden;border-bottom:1px solid var(--border);">
              {p.frontmatter.imagen && <img src={p.frontmatter.imagen} alt={p.frontmatter.title} style="width:100%;height:100%;object-fit:cover;" />}
              <span style="position:absolute;top:14px;left:14px;font-size:11px;font-weight:500;padding:4px 12px;border-radius:20px;background:var(--bg);color:var(--accent);border:1px solid rgba(29,230,181,0.3);">{p.frontmatter.category}</span>
            </div>
            <div style="padding:24px 22px;">
              <p style="font-size:12px;color:var(--muted);margin-bottom:10px;">{p.frontmatter.date} · {p.frontmatter.minutos} min</p>
              <h2 style="font-family:var(--serif);font-size:20px;line-height:1.35;margin-bottom:12px;color:var(--text);">{p.frontmatter.title}</h2>
              <p style="font-size:14px;color:var(--muted);line-height:1.65;">{p.frontmatter.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</Layout>

<style>
.blog-li-card:hover { border-color: rgba(29,230,181,0.2) !important; transform: translateY(-3px); }
@media (max-width:900px) { div[style*="repeat(3"] { grid-template-columns:1fr !important; } }
</style>
